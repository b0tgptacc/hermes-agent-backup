+@contextmanager
+def _typing_paused_for_interaction(adapter, chat_id: str):
+    """Pause a platform typing indicator and always resume it afterward.
+
+    Interactive prompts intentionally hide typing while the user is deciding.
+    The refresh loop is still alive, so clearing the pause marker after every
+    exit path (answer, timeout, send failure, or exception) restores the native
+    indicator for the remainder of the agent turn.
+    """
+    paused = False
+    try:
+        adapter.pause_typing_for_chat(chat_id)
+        paused = True
+    except Exception:
+        pass
+    try:
+        yield
+    finally:
+        if paused:
+            try:
+                adapter.resume_typing_for_chat(chat_id)
+            except Exception:
+                pass
+
+
