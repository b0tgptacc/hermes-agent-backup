{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.hermes/contracts/execution-ledger-v1.schema.json",
  "title": "Developer execution ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ledger_version", "task_id", "role", "parent_id", "workspace", "worktree",
    "branch", "base_sha", "artifact_kind", "hash_algorithm",
    "hash_canonicalization", "result_sha_or_diff_hash", "input_artifacts",
    "changed_files", "commands", "review_verdicts", "retry_count", "started_at",
    "finished_at", "residual_risks"
  ],
  "properties": {
    "ledger_version": {"const": "developer-execution/v1"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "role": {"enum": ["primary", "implementer", "reviewer"]},
    "parent_id": {"type": ["string", "null"], "minLength": 1},
    "workspace": {"type": "string", "pattern": "^[A-Za-z]:/"},
    "worktree": {"type": "string", "pattern": "^[A-Za-z]:/"},
    "branch": {"type": ["string", "null"], "minLength": 1},
    "base_sha": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40,64}$"},
    "artifact_kind": {"enum": ["working_tree_files", "git_diff", "commit_tree", "archive"]},
    "hash_algorithm": {"const": "sha256"},
    "hash_canonicalization": {"enum": ["path-nul-bytes", "git-diff-bytes", "git-tree-archive-bytes", "archive-bytes"]},
    "result_sha_or_diff_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "input_artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "path", "sha256", "validated"],
        "properties": {
          "kind": {"enum": ["research_handoff", "plan", "specification", "patch", "other"]},
          "path": {"type": "string", "pattern": "^(?:(?!\\.\\.?/)[A-Za-z0-9._-]+/)*(?!\\.\\.?$)[A-Za-z0-9._-]+$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "validated": {"const": true}
        }
      }
    },
    "changed_files": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?:(?!\\.\\.?/)[A-Za-z0-9._-]+/)*(?!\\.\\.?$)[A-Za-z0-9._-]+$"}
    },
    "commands": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["command", "exit_code", "summary"],
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "exit_code": {"type": "integer"},
          "summary": {"type": "string", "minLength": 1}
        }
      }
    },
    "review_verdicts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["artifact_hash", "verdict", "reviewer"],
        "properties": {
          "artifact_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "verdict": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
          "reviewer": {"type": "string", "minLength": 1}
        }
      }
    },
    "retry_count": {"type": "integer", "minimum": 0},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "residual_risks": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
